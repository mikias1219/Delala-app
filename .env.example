# API (use 0.0.0.0 so phones on your Wi‑Fi can reach the dev server)
NODE_ENV=development
PORT=3010
API_HOST=0.0.0.0
API_PREFIX=api/v1

# PostgreSQL (host port — avoids conflict with default 5432 / other apps)
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_HOST_PORT=5435
DATABASE_USER=delala
DATABASE_PASSWORD=delala_dev_password
DATABASE_NAME=delala

# Redis (host port — avoids conflict with default 6379)
REDIS_HOST=localhost
REDIS_PORT=6381

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# OTP (dev mode returns code in API response for testing)
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true

# CORS (comma-separated; add your LAN IP if testing from a browser)
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
