# API
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_HOST_PORT=5433
DATABASE_USER=thcp
DATABASE_PASSWORD=thcp_dev_password
DATABASE_NAME=thcp

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# OTP (Ethio Telecom / Afro SMS — wire in Sprint 1)
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
